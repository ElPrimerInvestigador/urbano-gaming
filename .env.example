# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit actual credentials.

# Supabase project URL (Project Settings > API)
SUPABASE_URL=

# Supabase service role key (Project Settings > API)
# This key bypasses row-level security — server-side use only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase anon key (Project Settings > API) — browser-public by design.
# Served to static public/*.html pages via GET /api/gaming/config
# (see that route's own comment for why public HTML cannot receive
# NEXT_PUBLIC_* build-time env vars in this repository). Must match
# whichever project SUPABASE_URL above points to.
SUPABASE_ANON_KEY=
